# Google OAuth credentials for the Google Tasks integration.
#
# Copy this file to `.env` and fill in the values from the Google Cloud Console
# (see README.md -> "Google Tasks integration" for the click-by-click steps).
#
# The MAIN_VITE_ prefix is what makes electron-vite expose these to the main
# process. A plain GOOGLE_CLIENT_ID would not be visible to the app.
#
# The app works fully without these; only the Google panel stays disabled.

MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
